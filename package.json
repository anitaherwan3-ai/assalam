{
  "name": "assalam-mysql-preview",
  "version": "1.0.0",
  "private": true,
  "description": "Isolated MySQL-compatible TiDB migration backend for Klinik Assalaam",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm test && node scripts/apply-preview-migrations.js",
    "test": "node --test tests/*.test.js",
    "cutover:check": "node scripts/check-cutover-readiness.js",
    "auth:schema-check": "auth check schema --config ./lib/auth.config.mjs",
    "migration:profile": "node scripts/profile-firebase-export.js",
    "migration:relationships": "node scripts/check-firebase-relationships.js",
    "migration:identities": "node scripts/reconcile-firebase-identities.js"
  },
  "dependencies": {
    "mysql2": "^3.15.3",
    "better-auth": "1.7.25"
  },
  "devDependencies": {
    "auth": "1.7.25"
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function initialOwner() {
      return request.auth != null && request.auth.token.email in [
        'praktekrose@gmail.com', 'nursalim42@gmail.com'
      ];
    }
    function ownerDocId() {
      return request.auth.token.email == 'praktekrose@gmail.com' ? 'praktekrose' :
        (request.auth.token.email == 'nursalim42@gmail.com' ? 'pimpinan2' : '');
    }
    // Profil staf menggunakan alamat email sebagai ID dokumen. Email Firebase
    // yang terverifikasi menjadi identitas; staf tidak dapat mengubah profilnya.
    function staffProfileExists() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/k_users/$(request.auth.token.email));
    }
    function staffProfile() {
      return get(/databases/$(database)/documents/k_users/$(request.auth.token.email)).data;
    }
    function staffActive() {
      return staffProfileExists() &&
        staffProfile().email == request.auth.token.email &&
        staffProfile().active == true &&
        staffProfile().role in ['admin', 'kasir'];
    }
    function signedIn() {
      return request.auth != null && (initialOwner() || staffActive());
    }
    function pimpinan() { return initialOwner(); }
    function adminOrPimpinan() {
      return signedIn() && (initialOwner() || staffProfile().role == 'admin');
    }
    function kasirOrAbove() {
      return signedIn() && (initialOwner() || staffProfile().role in ['kasir', 'admin']);
    }

    match /klinik_config/{document} {
      allow read: if signedIn();
      allow write: if pimpinan();
    }

    match /k_users/{document} {
      // Pimpinan dapat melihat semua profil; staf hanya dapat membaca profil sendiri.
      allow read: if initialOwner() ||
        (request.auth != null && document == request.auth.token.email);
      // Bootstrap dua profil Pimpinan yang sudah ada tetap dipertahankan.
      allow create: if initialOwner() && document == ownerDocId() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.role == 'pimpinan' && request.resource.data.active == true;
      allow update: if initialOwner() && (
        (document == ownerDocId() &&
          request.resource.data.uid == request.auth.uid &&
          request.resource.data.email == request.auth.token.email &&
          request.resource.data.role == 'pimpinan' &&
          request.resource.data.active == true &&
          (!('uid' in resource.data) || resource.data.uid == null || resource.data.uid == request.auth.uid))
        ||
        (document in ['assalamadmin1@gmail.com', 'assalamkasir1@gmail.com'] &&
          request.resource.data.email == document &&
          request.resource.data.role in ['admin', 'kasir'] &&
          request.resource.data.active is bool)
      );
      allow create: if initialOwner() && (
        (document == ownerDocId() &&
          request.resource.data.uid == request.auth.uid &&
          request.resource.data.email == request.auth.token.email &&
          request.resource.data.role == 'pimpinan' &&
          request.resource.data.active == true)
        ||
        (document in ['assalamadmin1@gmail.com', 'assalamkasir1@gmail.com'] &&
          request.resource.data.email == document &&
          request.resource.data.role in ['admin', 'kasir'] &&
          request.resource.data.active == true)
      );
      allow delete: if initialOwner() &&
        document in ['assalamadmin1@gmail.com', 'assalamkasir1@gmail.com'];
    }

    match /k_log/{document} {
      allow read: if adminOrPimpinan();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if pimpinan() ||
        (signedIn() && resource.data.uid == request.auth.uid &&
          request.resource.data.uid == request.auth.uid);
      allow delete: if pimpinan();
    }
    match /k_pasien/{document} { allow read, write: if kasirOrAbove(); }
    match /k_trx/{document} { allow read, write: if kasirOrAbove(); }
    match /k_shift/{document} { allow read, write: if kasirOrAbove(); }
    match /k_petty/{document} { allow read, write: if kasirOrAbove(); }
    match /k_obat/{document} { allow read: if signedIn(); allow write: if adminOrPimpinan(); }
    match /k_tarif/{document} { allow read: if signedIn(); allow write: if adminOrPimpinan(); }
    match /k_paket/{document} { allow read: if signedIn(); allow write: if adminOrPimpinan(); }
    match /k_batch/{document} { allow read: if signedIn(); allow write: if adminOrPimpinan(); }
    match /k_beli/{document} { allow read, write: if adminOrPimpinan(); }
    match /k_biaya/{document} { allow read, write: if adminOrPimpinan(); }
    match /k_loss/{document} { allow read, write: if adminOrPimpinan(); }
    match /k_returJual/{document} { allow read, write: if adminOrPimpinan(); }
    match /k_returBeli/{document} { allow read, write: if adminOrPimpinan(); }
  }
}